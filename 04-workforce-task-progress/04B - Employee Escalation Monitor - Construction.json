    {
      "parameters": {
        "sendTo": "youremail@email.com",
        "subject": "=🚨 Employee Unresponsive — {{$json.fields[\"Task Name\"]}} | {{$json.fields[\"Project ID\"]}}",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:auto;color:#333;\">\n\n  <div style=\"background:#991b1b;padding:24px;color:white;\">\n    <h2 style=\"margin:0;\">Construction Operations</h2>\n    <p style=\"margin:6px 0 0;color:#fecaca;\">Management Escalation</p>\n  </div>\n\n  <div style=\"padding:24px;background:#f9fafb;\">\n\n    <p>Hi,</p>\n\n    <p>\n      A scheduled construction task requires management attention.\n      The assigned employee has not provided a STARTED confirmation\n      after receiving both a work reminder and a follow-up.\n    </p>\n\n    <div style=\"background:white;border:1px solid #fecaca;padding:18px;margin:20px 0;\">\n\n      <p style=\"margin:0 0 10px;\">\n        <strong>Project</strong><br>\n        {{$json.fields[\"Project ID\"]}}\n      </p>\n\n      <p style=\"margin:0 0 10px;\">\n        <strong>Task</strong><br>\n        {{$json.fields[\"Task Name\"]}}\n      </p>\n\n      <p style=\"margin:0 0 10px;\">\n        <strong>Task ID</strong><br>\n        {{$json.fields[\"Task ID\"]}}\n      </p>\n\n      <p style=\"margin:0 0 10px;\">\n        <strong>Assigned Employee</strong><br>\n        {{$json.fields[\"Assigned Employee\"]}}\n      </p>\n\n      <p style=\"margin:0;\">\n        <strong>Scheduled Date</strong><br>\n        {{$json.fields[\"Scheduled Date\"]}}\n      </p>\n\n    </div>\n\n    <div style=\"background:#fef2f2;border-left:4px solid #dc2626;padding:16px;margin-bottom:20px;\">\n      <strong>Current Status</strong><br><br>\n      {{$json.fields[\"Status\"]}}\n    </div>\n\n    <p>\n      The employee was sent an initial reminder followed by a\n      follow-up request, but no STARTED confirmation has been received.\n    </p>\n\n    <p>\n      <strong>Recommended action:</strong><br>\n      Contact the employee and confirm whether the task can proceed.\n    </p>\n\n    <p style=\"margin-top:24px;\">\n      <strong>Construction Operations</strong>\n    </p>\n\n  </div>\n\n</div>",
        "options": {}
      },
