      "parameters": {
        "sendTo": "={{$json.fields[\"Employee Email\"]}}",
        "subject": "=Work Reminder — {{$json.fields[\"Task Name\"]}} | {{$json.fields[\"Project ID\"]}}",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: auto; color: #333;\">\n\n  <div style=\"background:#1f2937; padding:24px; color:white;\">\n    <h2 style=\"margin:0;\">Construction Operations</h2>\n    <p style=\"margin:6px 0 0; color:#d1d5db;\">Work Assignment Reminder</p>\n  </div>\n\n  <div style=\"padding:24px; background:#f9fafb;\">\n\n    <p>Hi <strong>{{$json.fields[\"Assigned Employee\"]}}</strong>,</p>\n\n    <p>You have a scheduled task that requires your attention.</p>\n\n    <div style=\"background:white; border:1px solid #e5e7eb; padding:18px; margin:20px 0;\">\n\n      <p style=\"margin:0 0 10px;\">\n        <strong>Project</strong><br>\n        {{$json.fields[\"Project ID\"]}}\n      </p>\n\n      <p style=\"margin:0 0 10px;\">\n        <strong>Task</strong><br>\n        {{$json.fields[\"Task Name\"]}}\n      </p>\n\n      <p style=\"margin:0 0 10px;\">\n        <strong>Task ID</strong><br>\n        {{$json.fields[\"Task ID\"]}}\n      </p>\n\n      <p style=\"margin:0;\">\n        <strong>Scheduled</strong><br>\n        {{$json.fields[\"Scheduled Date\"]}}\n      </p>\n\n    </div>\n\n    <p><strong>When you begin the task, reply:</strong></p>\n\n    <div style=\"background:#eef2ff; padding:14px; border-radius:6px; font-family:monospace;\">\n      STARTED {{$json.fields[\"Task ID\"]}}\n    </div>\n\n    <p style=\"margin-top:20px;\">If there is an issue:</p>\n\n    <div style=\"font-family:monospace; line-height:1.8;\">\n      DELAYED {{$json.fields[\"Task ID\"]}} &lt;reason&gt;<br>\n      NEEDS HELP {{$json.fields[\"Task ID\"]}} &lt;reason&gt;\n    </div>\n\n    <p style=\"margin-top:24px;\">\n      Please keep your task status updated so the project team can track progress.\n    </p>\n\n    <p>Thank you,<br><strong>Construction Operations</strong></p>\n\n  </div>\n\n</div>",
        "options": {}
      },
