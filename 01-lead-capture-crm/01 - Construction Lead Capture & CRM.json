    {
      "parameters": {
        "sendTo": "youremail@email.com",
        "subject": "={{ \"🏗️ New Lead — \" + $('Prepare Lead Data').item.json.serviceRequired + \" — \" + $('Prepare Lead Data').item.json.fullName }}",
        "message": "={{\n`<!DOCTYPE html>\n<html>\n<body style=\"margin:0; padding:0; background-color:#f4f6f8; font-family:Arial, Helvetica, sans-serif;\">\n\n  <div style=\"max-width:650px; margin:30px auto; background:#ffffff; border-radius:10px; overflow:hidden;\">\n\n    <div style=\"padding:25px 30px; background:#1f2937; color:#ffffff;\">\n      <h1 style=\"margin:0; font-size:24px;\">🏗️ New Construction Lead</h1>\n      <p style=\"margin:8px 0 0; color:#d1d5db;\">\n        A new enquiry has been received through your website.\n      </p>\n    </div>\n\n    <div style=\"padding:30px;\">\n\n      <h2 style=\"color:#1f2937; margin-top:0;\">\n        ${$('Prepare Lead Data').item.json.fullName}\n      </h2>\n\n      <table style=\"width:100%; border-collapse:collapse;\">\n\n        <tr>\n          <td style=\"padding:10px; border-bottom:1px solid #e5e7eb;\">\n            <strong>Email</strong>\n          </td>\n          <td style=\"padding:10px; border-bottom:1px solid #e5e7eb;\">\n            ${$('Prepare Lead Data').item.json.email}\n          </td>\n        </tr>\n\n        <tr>\n          <td style=\"padding:10px; border-bottom:1px solid #e5e7eb;\">\n            <strong>Phone</strong>\n          </td>\n          <td style=\"padding:10px; border-bottom:1px solid #e5e7eb;\">\n            ${$('Prepare Lead Data').item.json.phone}\n          </td>\n        </tr>\n\n        <tr>\n          <td style=\"padding:10px; border-bottom:1px solid #e5e7eb;\">\n            <strong>Service</strong>\n          </td>\n          <td style=\"padding:10px; border-bottom:1px solid #e5e7eb;\">\n            ${$('Prepare Lead Data').item.json.serviceRequired}\n          </td>\n        </tr>\n\n        <tr>\n          <td style=\"padding:10px; border-bottom:1px solid #e5e7eb;\">\n            <strong>Location</strong>\n          </td>\n          <td style=\"padding:10px; border-bottom:1px solid #e5e7eb;\">\n            ${$('Prepare Lead Data').item.json.suburb}\n          </td>\n        </tr>\n\n        <tr>\n          <td style=\"padding:10px; border-bottom:1px solid #e5e7eb;\">\n            <strong>Estimated Budget</strong>\n          </td>\n          <td style=\"padding:10px; border-bottom:1px solid #e5e7eb;\">\n            ${$('Prepare Lead Data').item.json.budget}\n          </td>\n        </tr>\n\n        <tr>\n          <td style=\"padding:10px;\">\n            <strong>Preferred Contact</strong>\n          </td>\n          <td style=\"padding:10px;\">\n            ${$('Prepare Lead Data').item.json.preferredContact}\n          </td>\n        </tr>\n\n      </table>\n\n      <div style=\"margin-top:25px; padding:18px; background:#f3f4f6; border-radius:7px;\">\n        <strong style=\"color:#1f2937;\">Project Details</strong>\n        <p style=\"margin-bottom:0; line-height:1.6;\">\n          ${$('Prepare Lead Data').item.json.projectDescription}\n        </p>\n      </div>\n\n      <div style=\"margin-top:25px; padding:15px; background:#fff7ed; border-radius:7px;\">\n        <strong>Lead Status: New</strong><br>\n        Please contact this lead as soon as possible.\n      </div>\n\n    </div>\n\n    <div style=\"padding:18px 30px; background:#f3f4f6; color:#6b7280; font-size:12px;\">\n      This notification was sent automatically by your lead management system.\n    </div>\n\n  </div>\n\n</body>\n</html>`\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [832, 0],
      "id": "5759e7b7-482d-4027-828c-b565a14421d3",
      "name": "Notify Construction Company",
      "webhookId": "df043431-db53-45c2-8852-fcfb346742c9"
    },
    {
      "parameters": {
        "sendTo": "={{ $('Prepare Lead Data').item.json.email }}",
        "subject": "={{ \"We've received your enquiry, \" + $('Prepare Lead Data').item.json.fullName }}",
        "message": "={{ `<!DOCTYPE html> <html> <body style=\"margin:0; padding:0; background:#f4f6f8; font-family:Arial, Helvetica, sans-serif;\">    <div style=\"max-width:650px; margin:30px auto; background:#ffffff; border-radius:10px; overflow:hidden;\">      <div style=\"padding:28px 32px; background:#1f2937; color:#ffffff;\">       <h1 style=\"margin:0; font-size:25px;\">         We've received your enquiry       </h1>        <p style=\"margin:9px 0 0; color:#d1d5db;\">         Thank you for getting in touch.       </p>     </div>      <div style=\"padding:32px; color:#374151; line-height:1.6;\">        <p style=\"font-size:17px;\">         Hi ${$('Prepare Lead Data').item.json.fullName},       </p>        <p>         Thank you for contacting us. We've successfully received your enquiry and a member of our team will review your project details.       </p>        <p>         We'll get back to you as soon as possible.       </p>        <div style=\"margin:25px 0; padding:20px; background:#f3f4f6; border-radius:8px;\">          <h3 style=\"margin-top:0; color:#1f2937;\">           Your enquiry         </h3>          <p style=\"margin:7px 0;\">           <strong>Service:</strong>           ${$('Prepare Lead Data').item.json.serviceRequired}         </p>          <p style=\"margin:7px 0;\">           <strong>Location:</strong>           ${$('Prepare Lead Data').item.json.suburb}         </p>          <p style=\"margin:7px 0;\">           <strong>Preferred contact:</strong>           ${$('Prepare Lead Data').item.json.preferredContact}         </p>        </div>        <p>         If you need to add any information, simply reply to this email.       </p>        <p style=\"margin-top:28px;\">         Kind regards,<br>         <strong>The Construction Team</strong>       </p>      </div>      <div style=\"padding:18px 32px; background:#f3f4f6; color:#6b7280; font-size:12px;\">       This is an automated confirmation email. Please do not reply if your business does not monitor this inbox.     </div>    </div>  </body> </html>` }}",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [1040, 0],
      "id": "6665695c-3d3c-4613-b8ae-ae7b9f3afbaa",
      "name": "Customer Confirmation Email",
      "webhookId": "fa3a0cf2-0781-4194-956b-6dec833184f5"
    },
    {
      "parameters": {
        "jsCode": "const fields = $json.body.data.fields;\n\nconst getField = (label) => {\n  const field = fields.find(f => f.label === label);\n  return field?.value ?? \"\";\n};\n\nreturn {\n  json: {\n    fullName: getField(\"Full Name\"),\n    email: getField(\"Email\"),\n    phone: getField(\"Phone Number\"),\n    serviceRequired: getField(\"Service Required\"),\n    projectDescription: getField(\"Project Description\"),\n    suburb: getField(\"Suburb\"),\n    budget: getField(\"Budget\"),\n    preferredContact: getField(\"Preferred Contact\"),\n    leadSource: getField(\"How did you found out about us?\"),\n    receivedAt: $json.body.data.createdAt,\n    leadId: $json.body.data.submissionId\n  }\n};"
      },
