    {
      "parameters": {
        "jsCode": "const aiText = $json.output[0].content[0].text;\n\nconst cleanedText = aiText\n  .replace(/^```json\\s*/i, '')\n  .replace(/^`json\\s*/i, '')\n  .replace(/```$/i, '')\n  .trim();\n\nconst data = JSON.parse(cleanedText);\n\n// Extract a plain email address if AI returns Markdown formatting\nif (data.customerEmail) {\n  const emailMatch = data.customerEmail.match(\n    /[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/i\n  );\n\n  if (emailMatch) {\n    data.customerEmail = emailMatch[0];\n  }\n}\n\nreturn {\n  json: data\n};"
      },
