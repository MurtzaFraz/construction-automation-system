      "id": "3723e396-0b33-4d00-8847-32e9470af904",
      "name": "Send AI Enquiry Summary",
      "webhookId": "c3e4d159-c156-4917-b72d-e5e1bc0c7cae"
    },
    {
      "parameters": {
        "jsCode": "const aiText = $json.output[0].content[0].text;\n\nconst cleanedText = aiText\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\nconst data = JSON.parse(cleanedText);\n\n// Extract a plain email address even if AI returns:\n// [email@example.com](mailto:email@example.com)\n// or:\n// [email@example.com](mailto\\:email@example.com)\n\nif (data.customerEmail && data.customerEmail !== 'Unknown') {\n  const emailMatch = data.customerEmail.match(\n    /[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/i\n  );\n\n  data.customerEmail = emailMatch\n    ? emailMatch[0]\n    : data.customerEmail;\n}\n\nreturn {\n  json: data\n};"
      },
