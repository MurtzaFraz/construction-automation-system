    {
      "parameters": {
        "sendTo": "youremail@email.com",
        "subject": "={{ \"New AI-Classified Enquiry — \" + $('Parse AI Enquiry Data').item.json.serviceRequired }}",
        "message": "={{ `<!DOCTYPE html> <html> <body style=\"margin:0; padding:0; background:#f4f6f8; font-family:Arial, Helvetica, sans-serif;\">  <div style=\"max-width:700px; margin:30px auto; background:#ffffff; border-radius:10px; overflow:hidden;\">    <div style=\"padding:25px 30px; background:#1f2937; color:#ffffff;\">     <h1 style=\"margin:0; font-size:24px;\">       New Construction Enquiry     </h1>      <p style=\"margin:8px 0 0; color:#d1d5db;\">       AI has analysed and organised the enquiry.     </p>   </div>    <div style=\"padding:30px; color:#374151; line-height:1.6;\">      <div style=\"padding:16px; background:#fff7ed; border-radius:8px; margin-bottom:22px;\">       <strong>Status:</strong>       Needs Review     </div>      <h2 style=\"font-size:18px; color:#1f2937;\">       Customer Details     </h2>      <p>       <strong>Name:</strong>       ${$('Parse AI Enquiry Data').item.json.customerName}     </p>      <p>       <strong>Email:</strong>       ${$('Parse AI Enquiry Data').item.json.customerEmail}     </p>      <p>       <strong>Phone:</strong>       ${$('Parse AI Enquiry Data').item.json.customerPhone}     </p>      <h2 style=\"font-size:18px; color:#1f2937; margin-top:25px;\">       Project Details     </h2>      <p>       <strong>Service:</strong>       ${$('Parse AI Enquiry Data').item.json.serviceRequired}     </p>      <p>       <strong>Location:</strong>       ${$('Parse AI Enquiry Data').item.json.suburb}     </p>      <p>       <strong>Budget:</strong>       ${$('Parse AI Enquiry Data').item.json.budget}     </p>      <p>       <strong>Urgency:</strong>       ${$('Parse AI Enquiry Data').item.json.urgency}     </p>      <p>       <strong>Customer intent:</strong>       ${$('Parse AI Enquiry Data').item.json.intent}     </p>      <div style=\"margin-top:25px; padding:20px; background:#f3f4f6; border-radius:8px;\">        <h3 style=\"margin-top:0; color:#1f2937;\">         AI Summary       </h3>        <p style=\"margin-bottom:0;\">         ${$('Parse AI Enquiry Data').item.json.summary}       </p>      </div>      <div style=\"margin-top:20px; padding:18px; border-left:4px solid #f59e0b; background:#fffbeb;\">        <strong>Information to check:</strong>        <p style=\"margin:8px 0 0;\">         ${$('Parse AI Enquiry Data').item.json.missingInformation.join(', ')}       </p>      </div>      <p style=\"margin-top:28px;\">       Review the original customer email before preparing a quote or contacting the customer.     </p>    </div>    <div style=\"padding:16px 30px; background:#f3f4f6; color:#6b7280; font-size:12px;\">     Generated automatically by  Construction AI Automation.   </div>  </div>  </body> </html>` }}",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
